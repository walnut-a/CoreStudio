{
  "name": "image-board-desktop",
  "version": "1.1.36",
  "private": true,
  "license": "MIT",
  "description": "CoreStudio desktop image board",
  "bin": {
    "corestudio": "bin/corestudio.cjs"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron.cjs",
    "check:dev-port": "node scripts/ensure-dev-port.cjs",
    "check:bundle-budget": "node scripts/desktopBundleBudget.mts",
    "check:secrets": "node scripts/check-secrets.cjs",
    "dev:renderer": "vite --config vite.config.mts --host 127.0.0.1 --port 5174",
    "dev:composer": "vite --config vite.config.mts --host 127.0.0.1 --port 5174 --open /composer-lab.html",
    "dev:electron": "yarn ensure:electron && wait-on tcp:5174 file:dist-electron/main.js file:dist-electron/preload.js && node scripts/dev-electron.cjs",
    "build:renderer": "vite build --config vite.config.mts",
    "build:electron": "node scripts/build-electron.mjs",
    "check:bundle-paths": "node scripts/check-build-paths.cjs",
    "dev:desktop": "yarn check:dev-port && concurrently -k -n ELECTRON,RENDERER -c green,cyan \"yarn build:electron && yarn dev:electron\" \"yarn dev:renderer\"",
    "start": "yarn dev:desktop",
    "build": "yarn build:renderer && yarn build:electron",
    "preview": "yarn package:dev:dir && yarn open:dev:packaged",
    "package:dir:diagnostic": "yarn build && yarn check:bundle-paths --build && yarn check:secrets --source --package-inputs && electron-builder --dir && yarn check:bundle-paths --release && yarn check:secrets --release",
    "package:dev:dir": "yarn build && yarn check:bundle-paths --build && yarn check:secrets --source --package-inputs && electron-builder --dir --config electron-builder.dev.cjs",
    "open:dev:packaged": "node scripts/open-packaged-dev.cjs",
    "runtime:verify:source": "node scripts/runtime-instance.cjs --expect source-dev",
    "runtime:verify:preview": "node scripts/runtime-instance.cjs --expect packaged-preview",
    "runtime:stop:source": "node scripts/runtime-instance.cjs --expect source-dev --stop",
    "runtime:stop:preview": "node scripts/runtime-instance.cjs --expect packaged-preview --stop",
    "smoke:packaged": "node scripts/smoke-packaged.cjs",
    "notarize:release": "node scripts/notarize-release.cjs",
    "package:app": "node scripts/package-once.cjs",
    "package:app:raw": "yarn build && yarn check:bundle-paths --build && yarn check:secrets --source --package-inputs && electron-builder --mac dmg && yarn check:bundle-paths --release && yarn notarize:release && yarn check:secrets --release",
    "test": "cd ../.. && yarn test:desktop"
  },
  "dependencies": {
    "@lexical/react": "0.44.0",
    "lexical": "0.44.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@excalidraw/common": "0.18.0",
    "@excalidraw/element": "0.18.0",
    "@excalidraw/excalidraw": "0.18.0",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@google/genai": "1.49.0",
    "@types/node": "^24.8.1",
    "concurrently": "9.2.1",
    "electron": "41.2.0",
    "electron-builder": "26.8.1",
    "esbuild": "0.28.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "wait-on": "9.0.5"
  },
  "build": {
    "appId": "com.corestudio.desktop",
    "productName": "CoreStudio",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en",
      "en-US",
      "zh_CN",
      "zh-CN",
      "zh_TW",
      "zh-TW"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/codex-integration",
        "to": "codex-integration"
      },
      {
        "from": "resources/agent-integration",
        "to": "agent-integration"
      },
      {
        "from": "../../../docs/codex-integration.md",
        "to": "codex-integration/CODEX_INSTALLATION.md"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "identity": "junyan liu (CUP682RD2S)",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "CoreStudio ${version}",
      "backgroundColor": "#f5f5f5",
      "iconSize": 112,
      "iconTextSize": 14,
      "window": {
        "width": 640,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 210,
          "type": "file"
        },
        {
          "x": 460,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
